# Variables de entorno requeridas para Piccadely Panel
# COPIAR ESTE ARCHIVO COMO .env Y RELLENAR CON VALORES REALES
# El archivo .env NUNCA debe subirse a Git (está en .gitignore)
#
# En producción estas variables se configuran directamente en Railway:
# Railway → Piccadely-panel service → Variables

# ─── BASE DE DATOS ───────────────────────────────────────────────────
# Connection string completo de Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ─── TIENDA NUBE ─────────────────────────────────────────────────────
# Store ID de Piccadely en TN
TN_STORE_ID=

# Access token del partner de TN (NO compartir, NO commitear)
TN_ACCESS_TOKEN=

# Client secret de TN, usado para verificar firmas de webhooks
TN_CLIENT_SECRET=

# URL pública del backend para recibir webhooks (opcional, tiene default)
WEBHOOK_URL=https://piccadely-panel-production.up.railway.app/api/webhooks/tiendanube

# ─── TUSFACTURAS (FACTURACIÓN AFIP) ──────────────────────────────────
# Credenciales de la API de TusFacturas
TF_APIKEY=
TF_APITOKEN=
TF_USERTOKEN=

# Punto de venta autorizado en ARCA para Piccadely
TF_PDV=00007

# CUIT del emisor (sandbox vs productivo)
TF_CUIT_EMISOR=30712271503

# ─── AUTENTICACIÓN ───────────────────────────────────────────────────
# Secret para firmar JWT (cambiar invalida todas las sesiones)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=

# Secret para endpoints de admin (header x-admin-secret)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_SECRET=

# ─── OPCIONAL ────────────────────────────────────────────────────────
# Puerto en local (Railway lo asigna automáticamente)
PORT=3001
