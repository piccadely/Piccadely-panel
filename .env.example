# Variables de entorno requeridas para Piccadely Panel
# COPIAR ESTE ARCHIVO COMO .env Y RELLENAR CON VALORES REALES
# El archivo .env NUNCA debe subirse a Git (está en .gitignore)
#
# En producción estas variables se configuran directamente en Railway:
# Railway → Piccadely-panel service → Variables

# ─── BASE DE DATOS ───────────────────────────────────────────────────
# Connection string completo de Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ─── TIENDA NUBE ─────────────────────────────────────────────────────
# Store ID de Piccadely en TN
TN_STORE_ID=

# Access token del partner de TN (NO compartir, NO commitear)
TN_ACCESS_TOKEN=

# Client secret de TN, usado para verificar firmas de webhooks
TN_CLIENT_SECRET=

# URL pública del backend para recibir webhooks (opcional, tiene default)
WEBHOOK_URL=https://piccadely-panel-production.up.railway.app/api/webhooks/tiendanube

# ─── TUSFACTURAS (FACTURACIÓN AFIP) ──────────────────────────────────
# Credenciales de la API de TusFacturas
TF_APIKEY=
TF_APITOKEN=
TF_USERTOKEN=

# Punto de venta autorizado en ARCA para Piccadely
TF_PDV=00007

# CUIT del emisor (sandbox vs productivo)
TF_CUIT_EMISOR=30712271503

# ─── AUTENTICACIÓN ───────────────────────────────────────────────────
# Secret para firmar JWT (cambiar invalida todas las sesiones)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=

# Secret para endpoints de admin (header x-admin-secret)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_SECRET=

# ─── WHATSAPP CLOUD API (META) ───────────────────────────────────────
# Webhook: GET/POST {backend}/api/whatsapp/webhook
# Verify token: texto libre, el MISMO que se carga en Meta > WhatsApp > Configuración > Webhook
WA_VERIFY_TOKEN=
# App Secret de la app de Meta (Configuración > Básica). Valida la firma X-Hub-Signature-256 del POST.
WA_APP_SECRET=
# Token de acceso (System User permanente) y Phone Number ID para ENVIAR por la Cloud API.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Opcional: versión de la Graph API (default v25.0)
WA_GRAPH_VERSION=
# ID de la cuenta de WhatsApp Business (WABA): necesario para listar, crear y sincronizar plantillas.
WA_WABA_ID=
# Retención (job diario), por mensaje: aplica a conversaciones cerradas y en estado bot; nunca a
# pendiente_agente ni agente (hay alguien atendiendo). En una conversación activa solo se borran los mensajes viejos.
#  - TEXTO: borra mensajes (y sus archivos) más viejos que N días. Default 90. 0 = sin límite.
#  - ARCHIVOS: borra de R2 los archivos más viejos que N días; el mensaje queda como "archivo vencido". Default 90. 0 = sin límite.
WA_RETENCION_TEXTO_DIAS=90
WA_RETENCION_ARCHIVOS_DIAS=90

# ─── ARCHIVOS: CLOUDFLARE R2 (API S3) ────────────────────────────────
# Bucket PRIVADO para los archivos de WhatsApp (se sirven por el backend o con URLs firmadas cortas).
# Al arrancar, el server hace un autotest y loguea "R2: OK" o "R2: ERROR <motivo>". Si falla o faltan
# variables, solo se deshabilitan los archivos de WhatsApp; el resto funciona normal.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ─── OPCIONAL ────────────────────────────────────────────────────────
# Puerto en local (Railway lo asigna automáticamente)
PORT=3001
